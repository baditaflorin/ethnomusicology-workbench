{
  "name": "ethnomusicology-workbench",
  "version": "0.1.0",
  "description": "Browser-based ethnomusicology lab for local audio transcription, analysis, annotation, statistics, and score export.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "node scripts/clean-pages-build.mjs && tsc -b && vite build && node scripts/copy-spa-fallback.mjs && node scripts/verify-docs.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "pages:serve": "rm -rf .tmp/pages && mkdir -p .tmp/pages && cp -R docs .tmp/pages/ethnomusicology-workbench && http-server .tmp/pages -p 4173 -c-1 --silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "fmt": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.30.0",
    "@tanstack/react-query": "^5.90.12",
    "cytoscape": "^3.33.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.25",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.14"
  }
}
